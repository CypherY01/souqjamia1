{
  "name": "souqjamia1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @souq/web dev",
    "dev:worker": "pnpm --filter @souq/worker dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @souq/tests test",
    "test:integration": "pnpm --filter @souq/tests test:integration",
    "test:e2e": "pnpm --filter @souq/tests test:e2e",
    "build": "pnpm --filter @souq/web build",
    "db:start": "pnpm --filter @souq/db db:start",
    "db:stop": "pnpm --filter @souq/db db:stop",
    "db:status": "pnpm --filter @souq/db db:status",
    "db:reset": "pnpm --filter @souq/db db:reset",
    "db:lint": "pnpm --filter @souq/db db:lint",
    "env:local": "node scripts/write-local-env.ts",
    "emails:check": "pnpm --filter @souq/db emails:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:lint": "redocly lint contracts/openapi.yaml --config contracts/redocly.yaml",
    "check:contract-ids": "redocly bundle contracts/openapi.yaml --ext json | node scripts/check-contract-ids.ts",
    "check:bundle": "node scripts/check-client-bundle.ts",
    "check:css": "node scripts/check-logical-css.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "check:supabase-images": "node scripts/check-supabase-images.ts",
    "secrets:scan": "node scripts/secrets-scan.ts"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@redocly/cli": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

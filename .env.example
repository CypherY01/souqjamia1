# سوق الجامعة: environment variables.
# Copy this file to .env.local and put the values there. Never commit real values.
# For local development, `pnpm env:local` writes apps/web/.env.local and apps/worker/.env.local
# from the running local Supabase stack. Each variable is listed here, without a value, together
# with the code that reads it.

# ---- Web (apps/web/lib/env.ts) ----
# development | staging | production
APP_ENV=
# Trusted origin of the site, e.g. http://localhost:3000 (scheme, host, port; no path)
APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public, DEC36, DEC52). Locally and in CI the official test key
# that always passes; `pnpm env:local` writes it. The real site comes with cost stage 1.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# DEC63: true | false. Must match auth.email.enable_confirmations in packages/db/supabase/config.toml
EMAIL_CONFIRMATION_REQUIRED=
# Server secret, 32+ random characters. CSRF and cursor keys are derived from it with HKDF.
# Changing it invalidates CSRF tokens and open page cursors (ops/runbooks/secrets.md).
APP_SECRET=
# Secret for the readiness probe /readyz (X-Probe-Token), 32+ random characters
PROBE_TOKEN=
# Number of trusted proxies that append to X-Forwarded-For: 0 locally (SEC07)
TRUSTED_PROXY_HOPS=
# Contact address shown to restricted accounts for objections (FR78). The real one comes with
# G05; locally `pnpm env:local` writes a fixture in the reserved .test domain.
CONTACT_EMAIL=
# Optional (DEC74): RL02 signups per client address and hour. Unset or empty means 300.
# Reviewed after the load test (task 8.4).
SIGNUP_IP_LIMIT_PER_HOUR=
# Optional, E2E only (task 3.5): true replaces the Turnstile widget with a local stand-in that
# gives Cloudflare's test token, so the browser never contacts Cloudflare. Unset means false.
# Refused with APP_ENV=production. Leave it unset for the owner's local review.
TURNSTILE_STUB=

# ---- Worker email (apps/worker/src/env.ts, task 3.8) ----
# mailpit | resend. mailpit locally and in CI (`pnpm env:local` writes it), refused with
# APP_ENV=production; resend from cost stage 1 (plan/cost-plan.md).
EMAIL_TRANSPORT=
# The sender, "Name <address>". Locally an address on the reserved souqjamia1.test name; in
# production an address on souqjamia1.com once the domain is verified at Resend (G01).
EMAIL_FROM=
# mailpit only: the local Mailpit web address, e.g. http://127.0.0.1:54324 (its HTTP send API)
MAILPIT_URL=
# resend only: the Resend API key, re_... (secret, ops/runbooks/secrets.md)
RESEND_API_KEY=
# APP_ORIGIN and CONTACT_EMAIL above are read by the worker too, with the web app's values:
# links in email and the contact address in the deletion email.

# ---- Web and worker, each its own value ----
# Postgres connection string (SEC02, DEC36). The web app connects as souq_web and the worker as
# souq_worker; each refuses any other role. Locally `pnpm env:local` sets a new random password
# for both roles and writes each app's own value into apps/web/.env.local and
# apps/worker/.env.local. APP_ENV above is read by the worker too.
DATABASE_URL=

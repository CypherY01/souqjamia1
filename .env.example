# سوق الجامعة: environment variables.
# Copy this file to .env.local and put the values there. Never commit real values.
# For local development, `pnpm env:local` writes apps/web/.env.local and apps/worker/.env.local
# from the running local Supabase stack. Each variable is listed here, without a value, together
# with the code that reads it.

# ---- Web (apps/web/lib/env.ts) ----
# development | staging | production
APP_ENV=
# Trusted origin of the site, e.g. http://localhost:3000 (scheme, host, port; no path)
APP_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# DEC63: true | false. Must match auth.email.enable_confirmations in packages/db/supabase/config.toml
EMAIL_CONFIRMATION_REQUIRED=
# Server secret, 32+ random characters. CSRF and cursor keys are derived from it with HKDF.
# Changing it invalidates CSRF tokens and open page cursors (ops/runbooks/secrets.md).
APP_SECRET=
# Secret for the readiness probe /readyz (X-Probe-Token), 32+ random characters
PROBE_TOKEN=
# Number of trusted proxies that append to X-Forwarded-For: 0 locally (SEC07)
TRUSTED_PROXY_HOPS=

# ---- Worker (apps/worker/src/env.ts) ----
# APP_ENV above is read by the worker too.
# Postgres connection string for the souq_worker role (SEC02); the worker refuses any other role.
# Locally `pnpm env:local` sets a new random password for the role and writes this value.
DATABASE_URL=

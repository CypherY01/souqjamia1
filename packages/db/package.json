    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@souq/email": "workspace:*",
    "@souq/i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "supabase": "catalog:",
    "typescript": "catalog:"
  }
}
